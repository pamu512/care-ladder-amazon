# Bearer token required for /mcp and mutating API routes (camera, demo run,
# incident ack, learning writes). Fail-closed when unset unless the local opt-out is on.
# CARE_LADDER_API_TOKEN=change-me

# Loopback / pytest only. Never set this on a shared or hosted API.
# CARE_LADDER_ALLOW_INSECURE_LOCAL=1

# Extra MCP Host headers (ALB / CloudFront), comma-separated.
# CARE_LADDER_MCP_HOSTS=demo.example.com

# Extra camera URL hosts. Device indices are always allowed.
# Hostnames are resolved; cloud metadata IPs are always rejected.
# CARE_LADDER_CAMERA_HOSTS=camera.local,192.168.1.20

# Optional Kaggle API for fall-classifier training (see docs/fall-cv-training.md).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
