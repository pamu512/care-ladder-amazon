# Bearer token required for /mcp and mutating API routes (camera, demo run,
# incident ack, learning writes). Fail-closed when unset unless the local opt-out is on.
# CARE_LADDER_API_TOKEN=change-me

# Loopback / pytest only. Never set this on a shared or hosted API.
# CARE_LADDER_ALLOW_INSECURE_LOCAL=1

# Extra MCP Host headers (ALB / CloudFront / AgentCore target), comma-separated.
# Must include the hostname AgentCore Gateway calls, or /mcp returns 421.
# CARE_LADDER_MCP_HOSTS=demo.example.com

# SageMaker cue endpoint. Unset keeps models/fall_classifier.npz on device.
# CARE_LADDER_SAGEMAKER_ENDPOINT=care-ladder-cue
# CARE_LADDER_SAGEMAKER_REGION=us-east-1
# Spend gate for scripts that create or delete the endpoint:
# CARE_LADDER_SAGEMAKER_DEPLOY=1

# AgentCore Gateway MCP target. Not the shared opencv ALB until that host serves /mcp.
# CARE_LADDER_GATEWAY_MCP_URL=https://care-ladder-mcp.example.com/mcp/
# CARE_LADDER_AGENTCORE_REGION=us-east-1
# CARE_LADDER_AGENTCORE_DEPLOY=1

# Extra camera URL hosts. Device indices are always allowed.
# Hostnames are resolved; cloud metadata IPs are always rejected.
# CARE_LADDER_CAMERA_HOSTS=camera.local,192.168.1.20

# Optional Kaggle API for fall-classifier training (see docs/fall-cv-training.md).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
